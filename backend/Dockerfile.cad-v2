FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libseccomp2 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 10001 cad && useradd --uid 10001 --gid cad --create-home cad \
    && mkdir -p /var/lib/agent-cad && chown cad:cad /var/lib/agent-cad
COPY requirements-cad-v2.txt ./
RUN pip install --no-cache-dir -r requirements-cad-v2.txt
COPY app ./app
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 CAD_V2_DATA_DIR=/var/lib/agent-cad CAD_V2_ISOLATION=strict
USER cad
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["python", "-m", "uvicorn", "app.interfaces.cad_v2_app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
