# Local standalone login; set a private ASCII token, minimum 16 characters.
CAD_V2_LOCAL_TOKEN=
CAD_V2_DATA_DIR=/var/lib/agent-cad
CAD_V2_MAX_CONCURRENCY=2
CAD_V2_MAX_QUEUE=32
CAD_V2_MAX_REPAIRS=3
CAD_V2_TIMEOUT_SECONDS=90
# Linux Landlock ABI >=3 + libseccomp2; unavailable enforcement rejects jobs.
CAD_V2_ISOLATION=strict
# Trusted local development only: explicitly change to process-dev if needed.
# process-dev provides resource limits but no filesystem/network confinement.
# Optional for complex natural-language planning. Never commit real credentials.
CAD_V2_API_BASE=https://api.openai.com/v1
CAD_V2_API_KEY=
CAD_V2_MODEL=gpt-6.1-sol
CAD_V2_PLANNER_MODEL=gpt-6.1-sol
CAD_V2_EDITOR_MODEL=gpt-6.1-sol
CAD_V2_MODEL_TIMEOUT=60
CAD_V2_MODEL_RETRIES=2
