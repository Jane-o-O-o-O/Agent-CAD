FROM simpleyyt/manus-sandbox:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    libreoffice \
    antiword \
    poppler-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY app/services/file.py /app/app/services/file.py

RUN chown ubuntu:ubuntu /app/app/services/file.py
